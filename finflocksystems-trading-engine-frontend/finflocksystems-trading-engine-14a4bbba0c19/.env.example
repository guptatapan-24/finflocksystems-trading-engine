# QFS Frontend application (root/build context: Frontend)
PORT=8000
# Public URL of the Backend API, read at container start (written to /runtime-config.js, so changing it needs no rebuild).
# It must end in /api/v1: the Backend serves every endpoint under <APP_BASE_PATH>/api/v1/ and the frontend appends only
# the endpoint path (e.g. system/), so this value is the complete API root. Keep the host and slug in step with the
# Backend's PUBLIC_BASE_URL / APP_BASE_PATH.
BACKEND_API_URL=https://finflockqfsplatform.cloud/qfsplatform/ai_trading_engine_backend1/api/v1

# Build-time base. The Dockerfile already supplies this production default.
VITE_APP_BASE_PATH=/qfsplatform/trading_engine_frontend/
