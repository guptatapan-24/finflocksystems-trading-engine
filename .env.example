# ==============================================================================
# Finflock Trading Engine - Environment Configuration Template
# Copy this file to '.env' in the root directory before running docker-compose
# ==============================================================================

# Database Credentials (PostgreSQL 16)
POSTGRES_DB=trading_engine_db
POSTGRES_USER=admin
LOCAL_DB_PASSWORD=H95M5GblRGJleTumK0lYWg2QWB0W

# Redis Password (Redis 7 AOF)
REDIS_PASSWORD=redis_local_pw_123

# Django Core Security Keys
LOCAL_DJANGO_SECRET=django-insecure-secret-key-for-local-development-32chars
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:18000

# IBKR Gateway & Session Encryption
LOCAL_GATEWAY_TOKEN=local-gateway-token-secret-32chars-min
LOCAL_NOVNC_PASSWORD=novnc_local_pass
LOCAL_ENCRYPTION_KEY=8rAsGODCypce6xNBeQMmXi5BInJMuU8PTnhdGDIIsc8=

# Broker Adapter & Credentials
# Options for BROKER_ADAPTER: 'ib_async' (real IBKR) or 'mock' (local simulator)
BROKER_ADAPTER=ib_async
# Options for IBC_TRADING_MODE: 'paper' (port 4002, delayed data) or 'live' (port 4001, real-time)
IBC_TRADING_MODE=paper
IB_USERNAME=edemo
IB_PASSWORD=demouser
OPTIONS_GATEWAY_IMAGE=docker.io/rachitm4555/trading-engine-ib-gateway:options-20260928.1

# AI Intelligence Advisory Layer
# Provider options: 'fake' (for tests/local mock, no external API calls) or 'qch' / 'gemini'
INTELLIGENCE_ENABLED=true
INTELLIGENCE_LLM_PROVIDER=fake
QCH_BASE_URL=https://qfsplatform.com/qch-ai
QCH_API_KEY=

# Execution Safety Gates
ALLOW_LIVE_TRADING=false
GLOBAL_KILL_SWITCH=false
# CAUTION: Set to 'false' to preserve database state across restarts!
CLEANUP_DATABASE_ON_START=false

